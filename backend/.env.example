# Server
PORT=5001
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=doctordesk
DB_USER=postgres
DB_PASSWORD=your_password_here

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d

# Optional local demo seeding (set unique values before running npm run db:seed)
SEED_ADMIN_PASSWORD=
SEED_DOCTOR_PASSWORD=
SEED_PATIENT_PASSWORD=

# Cookie (OPTIONAL – signed cookies are not used; JWT handles auth integrity)
# COOKIE_SECRET=your_cookie_secret_change_this

# Frontend URL (REQUIRED in production for CORS)
# FRONTEND_URL=https://your-frontend-domain.com

# File Upload
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./src/uploads
