# Public DNS name pointing to this server (no scheme or path)
APP_DOMAIN=doctordesk.example.com

# PostgreSQL database credentials. Use long, random values.
DB_NAME=doctordesk
DB_USER=doctordesk
DB_PASSWORD=replace_with_a_random_hex_secret

# Generate a separate long random secret for JWT signing.
JWT_SECRET=replace_with_a_different_random_hex_secret
JWT_EXPIRES_IN=7d
